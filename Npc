end

-- ESP

local function RemoveESP(npc)
    local data = ESPObjects[npc]

    if data then
        data.Billboard:Destroy()
        ESPObjects[npc] = nil
    end
end

local function CreateESP(npc)
    if ESPObjects[npc] then
        return
    end

    local head = GetHead(npc) or GetRoot(npc)

    if not head then
        return
    end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "DeveloperNPCESP"
    billboard.Adornee = head
    billboard.Size = UDim2.fromOffset(200, 65)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = Gui

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.TextColor3 = GetNPCColor(npc)
    label.TextStrokeTransparency = 0
    label.Font = Enum.Font.GothamBold
    label.TextSize = Config.ESPSize
    label.Parent = billboard

    ESPObjects[npc] = {
        Billboard = billboard,
        Label = label
    }
end

local function UpdateESP(npc)
    if not Config.ESP then
        RemoveESP(npc)
        return
    end

    CreateESP(npc)

    local data = ESPObjects[npc]
    local humanoid = GetHumanoid(npc)

    if not data or not humanoid then
        return
    end

    local distance = GetDistance(npc)

    data.Billboard.Enabled = distance <= Config.ESPMaxDistance

    local lines = {}

    if Config.ESPName then
        table.insert(lines, npc.Name)
    end

    if Config.ESPHealth then
        table.insert(lines, "HP: " .. math.floor(humanoid.Health)
            .. "/" .. math.floor(humanoid.MaxHealth))
    end

    if Config.ESPDistance then
        table.insert(lines, math.floor(distance) .. " studs")
    end

    data.Label.Text = table.concat(lines, "\n")
    data.Label.TextSize = Config.ESPSize
    data.Label.TextColor3 = GetNPCColor(npc)
end

-- HEAD / BODY HITBOX VISUALIZER
-- Không thay đổi kích thước va chạm thật.

local function CreateBox(part, color, name)
    if not part or not part:IsA("BasePart") then
        return nil
    end

    local box = Instance.new("BoxHandleAdornment")
    box.Name = name
    box.Adornee = part
    box.AlwaysOnTop = true
    box.ZIndex = 5
    box.Transparency = 0.35
    box.Color3 = color
    box.Size = part.Size
    box.Parent = part

    return box
end

local function RemoveHitboxVisual(npc)
    local data = HitboxObjects[npc]

    if not data then
        return
    end

    if data.Head then
        data.Head:Destroy()
    end

    if data.Body then
        data.Body:Destroy()
    end

    HitboxObjects[npc] = nil
end

local function UpdateHitboxVisual(npc)
    if not Config.HitboxVisual then
        RemoveHitboxVisual(npc)
        return
    end

    local head = GetHead(npc)
    local body = GetBody(npc)

    local data = HitboxObjects[npc]

    if not data then
        data = {}
        HitboxObjects[npc] = data
    end

    -- HEAD: RED

    if Config.ShowHead and head then
        if not data.Head or data.Head.Adornee ~= head then
            if data.Head then
                data.Head:Destroy()
            end

            data.Head = CreateBox(
                head,
                Colors.Head,
                "NPC_Head_Debug"
            )
        end

        if data.Head then
            data.Head.Size = head.Size * Config.HeadScale
        end
    elseif data.Head then
        data.Head:Destroy()
        data.Head = nil
    end

    -- BODY: BLUE

    if Config.ShowBody and body then
        if not data.Body or data.Body.Adornee ~= body then
            if data.Body then
                data.Body:Destroy()
            end

            data.Body = CreateBox(
                body,
                Colors.Body,
                "NPC_Body_Debug"
            )
        end

        if data.Body then
            data.Body.Size = body.Size * Config.BodyScale
        end
    elseif data.Body then
        data.Body:Destroy()
        data.Body = nil
    end
end

-- AIM TAB: NPC SELECTION DEBUG ONLY

local function AimTab()
    ClearContent()

    Section("NPC TARGET DEBUG")

    Toggle("Enable NPC Selection", false, function(v)
        Config.AimNPC = v
    end)

    Dropdown("Target Part", {"Head", "Body"}, function(v)
        Config.AimPart = v
    end)

    Slider("Maximum Distance", 100, 1000, 1000, function(v)
        Config.AimDistance = v
    end)

    Toggle("Team Check", false, function(v)
        Config.TeamCheck = v
    end)

    Section("TARGET INFORMATION")

    local info = Instance.new("TextLabel")
    info.Name = "TargetInfo"
    info.Size = UDim2.new(1, -5, 0, 50)
    info.BackgroundColor3 = Colors.Button
    info.TextColor3 = Colors.Text
    info.Text = "NPC selection is disabled"
    info.Font = Enum.Font.Gotham
    info.TextSize = 12
    info.Parent = Content

    Instance.new("UICorner", info)

    local function UpdateTargetInfo()
        if not Config.AimNPC then
            info.Text = "NPC selection is disabled"
            return
        end

        local nearest
        local shortest = Config.AimDistance

        for _, npc in ipairs(GetNPCs()) do
            local root = GetRoot(npc)
            local humanoid = GetHumanoid(npc)

            if root and humanoid and humanoid.Health > 0 then
                local sameTeam =
                    Config.TeamCheck
                    and npc:GetAttribute("Team") ~= nil
                    and Player:GetAttribute("Team") ~= nil
                    and npc:GetAttribute("Team") == Player:GetAttribute("Team")

                local distance = GetDistance(npc)

                if not sameTeam and distance < shortest then
                    shortest = distance
                    nearest = npc
                end
            end
        end

        if nearest then
            info.Text = "NPC: " .. nearest.Name
                .. "\nDistance: " .. math.floor(shortest) .. " studs"
        else
            info.Text = "No NPC found"
        end
    end

    Connections.TargetInfo = RunService.Heartbeat:Connect(UpdateTargetInfo)
end

