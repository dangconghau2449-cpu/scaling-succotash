-- UI COMPONENTS

local function ClearContent()
    for _, item in ipairs(Content:GetChildren()) do
        if item:IsA("GuiObject")
        and item ~= ContentLayout
        and item ~= ContentPadding then
            item:Destroy()
        end
    end
end

local function Section(name)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -5, 0, 28)
    label.BackgroundTransparency = 1
    label.Text = "  " .. name
    label.TextColor3 = Colors.Accent
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.Parent = Content
end

local function Toggle(name, initial, callback)
    local state = initial

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -5, 0, 38)
    button.BackgroundColor3 = Colors.Button
    button.TextColor3 = Colors.Text
    button.Font = Enum.Font.Gotham
    button.TextSize = 13
    button.Parent = Content

    Instance.new("UICorner", button)

    local function Update()
        button.Text = name .. " : " .. (state and "ON" or "OFF")
        button.BackgroundColor3 = state and Colors.Active or Colors.Button
    end

    button.MouseButton1Click:Connect(function()
        state = not state
        Update()
        callback(state)
    end)

    Update()
end

local function Slider(name, min, max, default, callback)
    local value = Instance.new("TextBox")
    value.Size = UDim2.new(1, -5, 0, 38)
    value.BackgroundColor3 = Colors.Button
    value.TextColor3 = Colors.Text
    value.Font = Enum.Font.Gotham
    value.TextSize = 13
    value.Text = name .. " : " .. default
    value.ClearTextOnFocus = false
    value.Parent = Content

    Instance.new("UICorner", value)

    value.FocusLost:Connect(function()
        local number = tonumber(value.Text:match("[%d%.]+"))

        if number then
            number = math.clamp(number, min, max)
            value.Text = name .. " : " .. number
            callback(number)
        else
            value.Text = name .. " : " .. default
        end
    end)
end

local function Dropdown(name, options, callback)
    local index = 1

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -5, 0, 38)
    button.BackgroundColor3 = Colors.Button
    button.TextColor3 = Colors.Text
    button.Font = Enum.Font.Gotham
    button.TextSize = 13
    button.Parent = Content

    Instance.new("UICorner", button)

    local function Update()
        button.Text = name .. " : " .. options[index]
    end

    button.MouseButton1Click:Connect(function()
        index = index % #options + 1
        Update()
        callback(options[index])
    end)

    Update()
end

local function ActionButton(name, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -5, 0, 40)
    button.BackgroundColor3 = Colors.Accent
