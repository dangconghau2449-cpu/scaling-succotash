-- PERFORMANCE TAB

local function PerformanceTab()
    ClearContent()

    Section("PERFORMANCE")

    local function SetPerformance(mode)
        Config.Performance = mode

        if mode == "Normal" then
            Lighting.GlobalShadows = true
            Lighting.EnvironmentDiffuseScale = 1
            Lighting.EnvironmentSpecularScale = 1
        else
            Lighting.GlobalShadows = false
            Lighting.EnvironmentDiffuseScale = 0
            Lighting.EnvironmentSpecularScale = 0
        end
    end

    ActionButton("NORMAL GRAPHICS", function()
        SetPerformance("Normal")
    end)

    ActionButton("LOW GRAPHICS", function()
        SetPerformance("Low")
    end)

    Section("LOW GRAPHICS REDUCES LIGHTING COST")
end

