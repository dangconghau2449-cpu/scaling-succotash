-- HELPERS

local function GetHumanoid(npc)
    return npc:FindFirstChildOfClass("Humanoid")
end

local function GetRoot(npc)
    return npc:FindFirstChild("HumanoidRootPart")
end

local function GetHead(npc)
    return npc:FindFirstChild("Head")
end

local function GetBody(npc)
    return npc:FindFirstChild("UpperTorso")
        or npc:FindFirstChild("Torso")
        or npc:FindFirstChild("LowerTorso")
        or npc:FindFirstChild("HumanoidRootPart")
end

local function GetNPCColor(npc)
    local team = tonumber(npc:GetAttribute("Team")) or 1
    team = math.clamp(team, 1, 8)
    return TeamColors[team]
end

local function GetDistance(npc)
    local camera = Workspace.CurrentCamera
    local root = GetRoot(npc)

    if not camera or not root then
        return math.huge
    end

    return (camera.CFrame.Position - root.Position).Magnitude
end

local function GetNPCs()
    local result = {}

    if not NPCFolder then
        return result
    end

    for _, npc in ipairs(NPCFolder:GetChildren()) do
        if npc:IsA("Model") then
            local humanoid = GetHumanoid(npc)
            local root = GetRoot(npc)

            if humanoid and root and humanoid.Health > 0 then
                table.insert(result, npc)
            end
        end
    end

    return result
end

